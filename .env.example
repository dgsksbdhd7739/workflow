# Adresse des WorkFlow-Backends (server/). Fuer Android/Windows-Builds Pflicht;
# fuer die Web-App auf demselben Server kann sie leer bleiben.
VITE_API_URL=https://217-154-200-72.sslip.io
# Fuer einen lokalen App-Start ohne Server/Anmeldung auf true setzen (nur Beispieldaten).
VITE_LOKALE_DEMO=false
# Nur fuer scripts/create-unternehmen.mjs (muss zu PROVISION_SECRET in /etc/workflow/server.env passen)
PROVISION_SECRET=your-provision-secret
# Optional: abweichende Adresse fuer Live-Update-Dateien (Standard: <VPS>/updates)
UPDATE_BASIS_URL=https://217-154-200-72.sslip.io/updates
# Deploy/Live-Update per SSH (scripts/deploy-vps.mjs, scripts/publish-update.mjs)
VPS_HOST=203.0.113.10
VPS_USER=root
VPS_SSH_KEY=C:\Users\you\.ssh\workflow_vps_ed25519
