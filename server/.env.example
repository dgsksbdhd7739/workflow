# Backend-Konfiguration. Auf dem Server liegt die echte Datei unter
# /etc/workflow/server.env (nur root/workflow lesbar), lokal als server/.env.
DATABASE_URL=postgresql://workflow_api:PASSWORT@127.0.0.1:5432/workflow
# Mindestens 32 Zeichen, z. B. openssl rand -hex 48
JWT_SECRET=
PORT=3000
# Kommagetrennt: Web-App, Android (Capacitor), Windows (Tauri), lokale Entwicklung
ERLAUBTE_URSPRUENGE=https://217-154-200-72.sslip.io,capacitor://localhost,https://localhost,http://localhost,tauri://localhost,http://tauri.localhost,http://localhost:5173
# Nur fuer npm test: Test-Datenbank (wird von den Tests geleert und befuellt)
TEST_DATABASE_URL=postgresql://workflow_api:PASSWORT@127.0.0.1:5433/workflow_test
# Ablage der hochgeladenen Dateien (Standard: /var/lib/workflow/dateien)
DATEIEN_VERZEICHNIS=/var/lib/workflow/dateien
# Optional: erlaubt scripts/create-unternehmen.mjs, Firmen ohne Login anzulegen
PROVISION_SECRET=
# Optional: Firebase-Dienstkonto (JSON aus der Firebase-Konsole) fuer Chat-Push
FIREBASE_DIENSTKONTO_DATEI=/etc/workflow/firebase-dienstkonto.json
